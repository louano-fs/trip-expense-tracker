{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "app/api",
      "port": 3001,
      "env": { "PORT": "3001", "DATABASE_PATH": "data/dev.sqlite" }
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "app/web",
      "port": 5173,
      "env": { "API_PORT": "3001" }
    }
  ]
}
